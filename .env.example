# Clé API Resend (https://resend.com) — sans clé, les demandes sont journalisées côté serveur
RESEND_API_KEY=
# Adresse qui reçoit les pré-réservations
RESERVATION_TO_EMAIL=contact@autoclean-diois.fr
# Expéditeur vérifié dans Resend
RESERVATION_FROM_EMAIL="AutoClean Diois <no-reply@autoclean-diois.fr>"
